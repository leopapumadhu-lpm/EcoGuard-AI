# =============================================================================
# EcoGuard AI — Streamlit Secrets Template
# =============================================================================
# 1. Copy or rename this file to .streamlit/secrets.toml
# 2. Fill in your real IBM watsonx.ai credentials
# 3. NEVER commit secrets.toml to version control
#
# To run locally:   streamlit run app.py
# Streamlit Cloud:  paste these key/value pairs in the Secrets manager
# =============================================================================

# ---------------------------------------------------------------------------
# IBM watsonx.ai credentials (required for Climate Assistant — IBM Granite)
# ---------------------------------------------------------------------------
# WATSONX_APIKEY      : Your IBM Cloud API key
#                       Generate at https://cloud.ibm.com/iam/apikeys
# WATSONX_PROJECT_ID  : Your watsonx.ai project ID
#                       Found at https://eu-de.dataplatform.cloud.ibm.com/projects/
# WATSONX_URL         : Regional endpoint for your watsonx.ai instance
#                       eu-de  → https://eu-de.ml.cloud.ibm.com
#                       us-south → https://us-south.ml.cloud.ibm.com
#                       jp-tok → https://jp-tok.ml.cloud.ibm.com
# ---------------------------------------------------------------------------

WATSONX_APIKEY     = "your_ibm_cloud_api_key_here"
WATSONX_PROJECT_ID = "your_watsonx_project_id_here"
WATSONX_URL        = "https://eu-de.ml.cloud.ibm.com"
