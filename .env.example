# =============================================================================
# EcoGuard AI - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
#
# NEVER commit .env to version control.
#
# NOTE: EcoGuard AI reads IBM credentials from Streamlit secrets, not .env.
#       Populate .streamlit/secrets.toml (see .streamlit/secrets.toml.example)
#       for the Climate Assistant to work.
# =============================================================================

# IBM watsonx.ai credentials (Climate Assistant — IBM Granite)
# Also add these to .streamlit/secrets.toml for Streamlit to read them.
WATSONX_APIKEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://eu-de.ml.cloud.ibm.com
